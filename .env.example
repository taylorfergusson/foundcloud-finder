# Copy this file to .env (already gitignored) and fill in real values.
# Locally you can `export $(cat .env | xargs)` before running the app,
# or use a tool like python-dotenv / direnv to load it automatically.
# On the EC2 server these same keys live in /etc/foundcloud/foundcloud.env
# and are loaded by the foundcloud.service systemd unit.

DB_NAME=foundcloud_db
DB_USER=postgres
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

FRONTEND_ORIGIN=https://foundcloud.taylorfergusson.com
UPLOAD_FOLDER=uploads
